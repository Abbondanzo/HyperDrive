{
  "name": "hyperdrive",
  "version": "0.0.1",
  "description": "Nostalgia factory",
  "main": "./src/index.ts",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --mode=production --progress",
    "start": "cross-env NODE_ENV=development webpack-dev-server --progress",
    "download-songs": "ts-node --skip-project --compiler-options '{\"esModuleInterop\":true}' ./src/audio/downloader.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Abbondanzo/HyperDrive.git"
  },
  "keywords": [
    "3d",
    "canvas",
    "retrowave"
  ],
  "author": "Peter Abbondanzo, Erin Mittmann",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "events": "^3.3.0",
    "html-webpack-plugin": "^5.6.7",
    "prettier": "^3.9.5",
    "raw-loader": "^4.0.2",
    "stats.js": "^0.17.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0",
    "youtube-dl-exec": "^3.1.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "gl-matrix": "^3.4.4",
    "three": "^0.185.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "youtube-dl-exec"
    ]
  }
}
